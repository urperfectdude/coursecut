# The droplet's environment. Copy to `/opt/coursecut/.env`, fill it in, and
# `chmod 600` it. **It is created once, by hand, on the droplet** — it is not
# in the repo, not in the images, and not written by the deploy workflow.
#
# That is deliberate (plan §8). The deploy pipeline pushes code; it does not
# carry production secrets, so a compromised Actions run cannot read them and
# rotating one is an edit on the droplet rather than a redeploy.
#
# `docker compose` reads this file from its own directory for `${...}`
# interpolation in `compose.prod.yml`, and `api`/`worker` receive it whole via
# `env_file`. So every value here must be correct **from inside a container**:
# `postgres` is the database host, not `localhost`.
#
# Everything in `apps/api/.env.example` applies here too — this is the same
# environment `src/env.ts` reads, with production values.

# --- images ------------------------------------------------------------------

# Where `compose.prod.yml` pulls images from. GitHub Container Registry, so
# this is `ghcr.io/<your github owner>` — no account or token to create, and
# the deploy hands the droplet a short-lived token per run (runbook §4).
REGISTRY=ghcr.io/urperfectdude

# Which build is running. The deploy workflow rewrites this line to the commit
# SHA it just pushed; a rollback is setting it back to an older SHA and running
# `deploy.sh` again. `latest` works but makes "what is deployed?" unanswerable.
IMAGE_TAG=latest

# --- public identity ---------------------------------------------------------

# The domain Caddy gets a certificate for and `better-auth` builds links
# against. These two must agree, or sessions and invitation links break in ways
# that look unrelated to DNS.
APP_DOMAIN=coursecut.example.com
APP_URL=https://coursecut.example.com

# Let's Encrypt's contact address, for expiry and revocation notices.
# Required: Caddy's `email` directive with no argument is a syntax error, so a
# blank value here refuses the whole config and the site does not come up.
ACME_EMAIL=

# --- database ----------------------------------------------------------------

# Postgres is not published to the host (see `compose.prod.yml`), so these
# hostnames only resolve on the compose network. Generate both passwords with
# `openssl rand -hex 32` and never reuse them. **Hex, not base64**: these go
# inside `postgres://` URLs, where base64's `+` `/` `=` are reserved or
# mangled — the symptom is an auth failure with a password that looks right.
POSTGRES_PASSWORD=

# Serves requests. Least privilege, RLS applies. `APP_DB_PASSWORD` must match
# the password inside `DATABASE_URL` — `db:bootstrap` sets the role's password
# from `APP_DB_PASSWORD`, and the API connects with `DATABASE_URL`.
APP_DB_USER=coursecut_app
APP_DB_PASSWORD=
DATABASE_URL=postgres://coursecut_app:REPLACE_WITH_APP_DB_PASSWORD@postgres:5432/coursecut

# Migrations, bootstrap and the backup dump. Never serves a request.
DATABASE_ADMIN_URL=postgres://postgres:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/coursecut

PORT=3000

# --- auth --------------------------------------------------------------------

# Signs session cookies. `openssl rand -base64 48`. Rotating it signs everyone
# out, which is the intended effect of rotating it.
AUTH_SECRET=

# --- OpenAI (D7) -------------------------------------------------------------

# The platform-owned key. One key for every tenant; never in the database,
# never sent to the browser. Spend is ours, which is what the quotas below are
# for (M7) — they are the reason this no longer has to be invite-only.
#
# This file is committed (`.gitignore` un-ignores `.env.example`), so the real
# key belongs only in `/opt/coursecut/.env` on the droplet. Leave this blank.
OPENAI_API_KEY=

# --- quotas and cost caps (M7) -----------------------------------------------

# Platform defaults. `org_settings` overrides any of them per tenant, and a
# null there means "whatever is set here", so raising everyone's ceiling is a
# redeploy and raising one tenant's is an UPDATE.
#
# Conservative on purpose: raising a limit for a tenant who hit it is a
# one-line change, and refunding a month of Whisper spend is not.

# Minutes of audio one org may transcribe per calendar month. 600 ≈ $3.60 of
# Whisper at list price, plus the GPT analysis that rides along with it.
QUOTA_TRANSCRIPTION_MINUTES_PER_MONTH=600

# Bytes of source video + finished exports an org may hold at once (50 GiB).
# At R2's $0.015/GB that is about $0.75/month per tenant at the ceiling.
QUOTA_STORAGE_BYTES=53687091200

# Ceiling on one upload (5 GiB).
QUOTA_MAX_UPLOAD_BYTES=5368709120

# Queued-or-running jobs per org. Not capacity — fairness. The worker is
# concurrency 1, so this stops one tenant putting a thousand jobs in front of
# everyone else's. Big enough that importing a semester of lectures fits.
QUOTA_MAX_ACTIVE_JOBS=25

# Orgs one user may own. Without a cap, "sign up again" is a quota reset.
QUOTA_MAX_ORGS_PER_USER=3

# --- retention (M7, plan §9) -------------------------------------------------

# How long a finished export stays downloadable. It is derived data — losing it
# costs a re-export — and it is the storage line that otherwise grows without
# anyone deciding to keep anything.
RETENTION_EXPORT_DAYS=14

# How long a **source video** is kept. 0 means never expire, and that is the
# default deliberately: purging a tenant's uploads on a timer they never asked
# for is not something to switch on by accident, and cost is already bounded by
# the storage quota. `org_settings.retention_days` overrides it per tenant, and
# whatever is set here is what the Usage dialog tells users.
RETENTION_SOURCE_DAYS=0

# Grace before an abandoned upload row, or an object no row points at, is
# collected. Hours rather than minutes because the second one absorbs clock
# skew between the API and the object store as well as an upload in flight.
RETENTION_PENDING_UPLOAD_HOURS=24
RETENTION_ORPHAN_GRACE_HOURS=24

# When the worker runs the sweep (crontab syntax, UTC). Before the backup hour,
# so the dump is of a database that has already been tidied.
RETENTION_SWEEP_CRON=20 4 * * *

# --- transactional email (M7) ------------------------------------------------

# Password reset, and nothing else yet. Leave `MAIL_DRIVER` unset and there is
# no reset flow at all — no link on the sign-in screen, no form, and the API
# says so at `/api/config`. That is the intended state for a deployment with no
# provider; a form whose mail never arrives is worse than an absent one.
#
#   none    (default) no mail, no reset UI
#   log     writes the message to the server log — development only
#   resend  real delivery over Resend's HTTP API
#
# Postmark and SES are the same shape; adding one is a branch in `mail.ts`.
MAIL_DRIVER=none
MAIL_FROM=CourseCut <no-reply@coursecut.example.com>
MAIL_API_KEY=
# MAIL_API_URL=https://api.resend.com/emails

# --- object storage: Cloudflare R2 -------------------------------------------

# Same five variables MinIO takes locally, with R2's values (plan §5: no code
# difference, only configuration).
#
# The endpoint is account-specific and has no bucket in it — the bucket is
# `S3_BUCKET`, and a hostname must never reach the database or the browser
# (plan §3.4's portability rules).
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=coursecut-media

# An R2 API token scoped to **Object Read & Write on this bucket only**.
# Not an account-level token: this credential lives in a container that runs
# other people's video through ffmpeg, and it should be able to do nothing
# except read and write objects in one bucket.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# R2 uses virtual-hosted-style addressing. Only MinIO needs path-style.
S3_FORCE_PATH_STYLE=false

# How long a presigned URL lives. An hour covers a page of playback and one
# upload part on a slow line; shorter is safer, and the client re-mints.
S3_URL_TTL_SECONDS=3600

# --- backups -----------------------------------------------------------------

# A **separate bucket with a separate token**, so the credential the API and
# worker hold cannot read or delete the backups. If both used one token, an
# API compromise would take the recovery path with it.
BACKUP_DATABASE_URL=postgres://postgres:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/coursecut
BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=coursecut-backups
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAYS=30
BACKUP_HOUR_UTC=03

# --- tuning ------------------------------------------------------------------

# CPU ceiling for the worker while it shares a droplet with the API
# (plan §3.3). Raise or remove once the worker has its own box.
WORKER_CPUS=0.8
