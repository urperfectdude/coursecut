# Local development against infra/postgres/compose.yml — the same Postgres
# container `apps/api` uses. `stepcut` is a second database on that server,
# not a second container (plan decision 7); `npm run db:create` is what
# creates it.
#
# Copy to apps/stepcut-api/.env — that file is gitignored and must stay that
# way.
#
# These are dev-only credentials for a database bound to localhost. Nothing
# here is a production secret; production values live in the droplet's env
# file and GitHub Actions secrets, never in the repo.

# Serves requests. Least privilege, no BYPASSRLS.
DATABASE_URL=postgres://stepcut_app:stepcut_app_dev@localhost:5432/stepcut

# Migrations, bootstrap and database creation only. Never used to serve a
# request.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/stepcut

# The role `db:bootstrap` creates/updates. Must match DATABASE_URL above.
APP_DB_USER=stepcut_app
APP_DB_PASSWORD=stepcut_app_dev

# Where the SPA is served from. `better-auth` uses it to build reset-password
# links and as its trusted origin. In dev the Vite server proxies `/api` here,
# so the two are same-origin and the session cookie is first-party; in
# production this is the Caddy-terminated domain.
APP_URL=http://localhost:5174
PORT=3001

# Signs session cookies. Dev-only value — production's lives in the droplet's
# env file and GitHub Actions secrets, never here. Rotating it logs everyone
# out, which is the intended effect of rotating it.
AUTH_SECRET=dev_only_not_a_secret_change_me_0123456789
