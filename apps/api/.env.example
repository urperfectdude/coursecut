# Local development against infra/postgres/compose.yml.
# Copy to apps/api/.env — that file is gitignored and must stay that way.
#
# These are dev-only credentials for a database bound to localhost. Nothing
# here is a production secret; production values live in the droplet's env
# file and GitHub Actions secrets, never in the repo (plan §8).

# Serves requests. Least privilege, no BYPASSRLS — RLS is real for this role.
DATABASE_URL=postgres://coursecut_app:coursecut_app_dev@localhost:5432/coursecut

# Migrations, bootstrap and seed only. Never used to serve a request.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/coursecut

# The role `db:bootstrap` creates/updates. Must match DATABASE_URL above.
APP_DB_USER=coursecut_app
APP_DB_PASSWORD=coursecut_app_dev

# Where the SPA is served from. `better-auth` uses it to build reset-password
# links and as its trusted origin. In dev the Vite server proxies `/api` here,
# so the two are same-origin and the session cookie is first-party; in
# production this is the Caddy-terminated domain.
APP_URL=http://localhost:5173
PORT=3000

# Signs session cookies. Dev-only value — production's lives in the droplet's
# env file and GitHub Actions secrets, never here (plan §8). Rotating it logs
# everyone out, which is the intended effect of rotating it.
AUTH_SECRET=dev_only_not_a_secret_change_me_0123456789

# The platform-owned OpenAI key (D7). One key for every tenant, never in the
# database and never sent to the browser. Required from M5 on: the worker
# refuses to boot without it rather than accepting transcription jobs and
# failing every one of them.
OPENAI_API_KEY=

# Where the OpenAI API lives. Overridable so the pipeline tests can point the
# same code at a local stub (and so a deployment can route through a gateway);
# leave it unset for the real thing.
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- quotas and retention (M7) -----------------------------------------------
#
# Every one of these is a platform default that `org_settings` can override per
# tenant. The values below are the code's own defaults, spelled out so they are
# discoverable; leave them commented to get exactly these.
#
# Because the OpenAI key is ours (D7), transcription minutes are the meter that
# matters — they drive both the Whisper bill and the worker's CPU.
# QUOTA_TRANSCRIPTION_MINUTES_PER_MONTH=600
# QUOTA_STORAGE_BYTES=53687091200      # 50 GiB of source video + exports
# QUOTA_MAX_UPLOAD_BYTES=5368709120    # 5 GiB per file
# QUOTA_MAX_ACTIVE_JOBS=25             # queued or running, per org
# QUOTA_MAX_ORGS_PER_USER=3            # or "sign up again" is a quota reset

# Retention. Exports expire because they are derived; source video does not
# expire by default, because deleting someone's upload on a timer they never
# chose is not a sensible default (plan §9). `npm run retention:sweep` runs the
# collection by hand; the worker runs it on `RETENTION_SWEEP_CRON`.
# RETENTION_EXPORT_DAYS=14
# RETENTION_SOURCE_DAYS=0              # 0 = keep until deleted
# RETENTION_PENDING_UPLOAD_HOURS=24
# RETENTION_ORPHAN_GRACE_HOURS=24
# RETENTION_SWEEP_CRON=20 4 * * *

# --- transactional email (M7) ------------------------------------------------
#
# Unset means no mail and therefore no password-reset flow anywhere in the
# product — not a form that silently fails. `log` prints the reset link to this
# server's output, which is what you want locally; `resend` sends for real.
# MAIL_DRIVER=log
# MAIL_FROM=CourseCut <no-reply@localhost>
# MAIL_API_KEY=
# MAIL_API_URL=https://api.resend.com/emails

# --- Worker only (M5) --------------------------------------------------------
# The API reads none of these; `apps/worker` is the only process with ffmpeg
# and a scratch disk.

# System binaries locally; pinned in the worker image for production.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Where a job's source video, extracted audio and per-segment cuts live while
# it runs. Everything under here is transient — each job removes its own
# directory, and the worker clears the tree at startup.
# WORKER_SCRATCH_DIR=/tmp/coursecut-worker

# MinIO stands in for Cloudflare R2 locally — same S3 API, so only the
# endpoint and credentials differ (plan §5). R2 uses region "auto".
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=coursecut
S3_ACCESS_KEY_ID=coursecut
S3_SECRET_ACCESS_KEY=coursecut_dev_secret
# MinIO needs path-style addressing; R2 does not.
S3_FORCE_PATH_STYLE=true
