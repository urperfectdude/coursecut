# Baked into the `stepcut-web` image at build time (see
# `infra/docker/stepcut-web.Dockerfile`), not bind-mounted like the edge
# Caddy's `infra/docker/Caddyfile` is — this container is internal-only and
# reached solely through the edge Caddy's `{$STEPCUT_DOMAIN}` block, which
# owns TLS, HSTS/CSP headers and logging for the public response. All this
# one has to do is answer the internal proxy with the SPA: serve the built
# bundle and fall back to `index.html` for client-side routes.
#
# Lives here, alongside the app it serves, rather than under `infra/docker/`
# with the other Caddy config: `infra/docker/stepcut-web.Dockerfile`'s build
# context is `apps/` (same rule as every other image in this stack — see that
# Dockerfile's own header), so a file this Dockerfile `COPY`s has to be
# reachable from inside `apps/`. `infra/` is `apps/`'s sibling at the repo
# root and out of reach of that build entirely.

:80 {
	encode zstd gzip
	root * /srv

	# Vite fingerprints everything under /assets, so those are immutable and
	# cached hard, while the SPA shell must not be — otherwise a deploy leaves
	# browsers asking for the previous build's asset names until their cache
	# expires (which, unbounded, can be indefinitely).
	#
	# Matched on the *request* path, not `/index.html` literally: Caddy runs
	# `header` before `try_files`, so a matcher on `/index.html` only ever
	# fires for a client that requests that literal path — never for the
	# common case of loading `/` (or any client-side route), which is what
	# `try_files`'s fallback rewrites to *after* headers are already decided.
	# `infra/docker/Caddyfile`'s coursecut-web copy of this split has the same
	# gap; ported correctly here rather than reproducing it.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@shell not path /assets/*
	header @shell Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
