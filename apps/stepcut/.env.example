# Copy to apps/stepcut/.env for local development.
#
# Nothing to set today — the SPA always talks to the real `apps/stepcut-api`
# through the Vite dev proxy (see vite.config.ts). There is no mock mode here
# (unlike apps/web/.env.example): stepcut has no desktop counterpart that
# needs a standalone-in-browser fallback.

# Only needed if the API is somewhere other than the Vite proxy's /api —
# which would also mean giving up the same-origin cookie, so prefer the proxy.
# VITE_API_BASE=/api
